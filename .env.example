# ==============================================================================
# Expense Voucher Management System - Environment Variable Template
# ==============================================================================
# HOW TO CONFIGURE:
# 1. Copy this template file to create your active local environment file:
#      cp .env.example .env     (Linux / macOS / Git Bash)
#      copy .env.example .env   (Windows Command Prompt / PowerShell)
# 2. Fill in the placeholder values below with your environment-specific settings.
# 3. Never commit the actual `.env` file to source control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JSON Web Token (JWT) Security Configuration
# IMPORTANT: Replace with a secure, cryptographically random secret string in production.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Database Configuration
# Option A: SQLite (Default - zero setup required, pre-seeded on first launch)
DB_TYPE=sqlite
DB_PATH=./server/data/expense_vouchers.db

# Option B: PostgreSQL (Enterprise / Production deployment)
# Uncomment the line below to connect to an external PostgreSQL instance:
# DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/expense_voucher_db

# File Upload Configuration
# Directory for storing employee and director signature files (max size in megabytes)
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE_MB=5
