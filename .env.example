# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=prachay_securities_expense_voucher_jwt_secret_key_2026_production_safe
JWT_EXPIRES_IN=7d

# Database Configuration
# Uses SQLite locally by default (zero setup required).
# Can also be set to PostgreSQL / MySQL connection string if using external DB:
DB_TYPE=sqlite
DB_PATH=./server/data/expense_vouchers.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_voucher_db

# File Uploads
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE_MB=5
