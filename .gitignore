# ==============================================================================
# Expense Voucher Management System - Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
client/node_modules/
.pnp
.pnp.js

# Production Build Output
dist/
client/dist/
build/

# Vite & Bundler Caches
.vite/
client/.vite/
.cache/

# Environment Variables & Sensitive Secrets
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Runtime Databases & Cache Binaries
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
!server/data/.gitkeep

# User-Uploaded Signatures & Private File Assets
server/uploads/*
!server/uploads/.gitkeep

# Testing & Coverage Reports
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary Files & Scratch Storage
*.tmp
*.bak
*.swp
.tempmediaStorage/

# Operating System Metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
